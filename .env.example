# Server-only. Never prefix this value with PUBLIC_ or expose it to browser code.
OPENAI_API_KEY=
BODY_SIZE_LIMIT=2M
# 仅在需要紧急停用修订对照 WebSocket 时设为 false
VOXBRAID_RESPONSES_WEBSOCKET=true

# Required in production. The browser will show one HTTP Basic Auth prompt.
VOXBRAID_BASIC_AUTH_USERNAME=
VOXBRAID_BASIC_AUTH_PASSWORD=

# Optional read-only organization Admin key for the official usage summary.
OPENAI_ADMIN_KEY=
